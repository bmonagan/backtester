# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Data / cache (project-specific — cached OHLCV data shouldn't be committed)
data/cache/*
!data/cache/.gitkeep
/data/

# JS leftovers
node_modules/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
